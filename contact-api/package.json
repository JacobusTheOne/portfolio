{
  "name": "portfolio-contact-api",
  "private": true,
  "type": "module",
  "description": "Contact form backend for the portfolio: HTTP API -> Lambda -> DynamoDB, plus a daily SNS email digest.",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff --profile aws-project",
    "deploy": "cdk deploy --profile aws-project"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1171.0",
    "@aws-sdk/client-sns": "^3.1171.0",
    "@aws-sdk/lib-dynamodb": "^3.1171.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1149.0",
    "aws-cdk-lib": "2.277.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
